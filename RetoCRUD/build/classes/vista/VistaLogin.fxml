<AnchorPane id="AnchorPane" prefHeight="244.0" prefWidth="397.0" styleClass="background" stylesheets="@../css/estilo.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.Controlador">
    <children>
        <Label layoutX="85.0" layoutY="98.0" minHeight="16" minWidth="42.0" prefHeight="18.0" prefWidth="42.0" text="Email:" />
