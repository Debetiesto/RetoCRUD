      <PasswordField fx:id="txtContra" layoutX="170.0" layoutY="142.0" promptText="Contraseña" />
      <TextField fx:id="txtEmail" layoutX="170.0" layoutY="94.0" promptText="ejemplo@ejemplo.com" />
      <Label fx:id="lblNoCuenta" layoutX="180.0" layoutY="196.0" text="No tienes cuenta?" />
      <Label fx:id="lblInicia" layoutX="112.0" layoutY="37.0" text="INICIA SESIÓN">
         <font>
            <Font size="27.0" />
         </font>
      </Label>
      <Hyperlink fx:id="linkCrear" layoutX="297.0" layoutY="193.0" onAction="#venRegistrar" text="Crea Una!">
